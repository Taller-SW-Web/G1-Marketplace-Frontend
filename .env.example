# Server-only URL of Marketplace's BFF. Never put a G6 service token here.
MARKETPLACE_API_URL=http://127.0.0.1:10000

# Local demo only. Disabled in production regardless of this flag.
H3_FRONTEND_SANDBOX_ENABLED=false
# Exact browser origin used by the strict mutation/CSRF check (no trailing slash).
H3_FRONTEND_ORIGIN=http://127.0.0.1:3000
# Server-only JWTs issued by the backend sandbox: never commit their values.
H3_SANDBOX_TOKEN_A=
H3_SANDBOX_TOKEN_B=

# Enable only after the backend contract and persistent move idempotency pass integration tests.
H3_WISHLIST_READ_ENABLED=false
H3_WISHLIST_MOVE_ENABLED=false
