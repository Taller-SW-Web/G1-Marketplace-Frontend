# Server-only URL of Marketplace's BFF. Never put a G6 service token here.
MARKETPLACE_API_URL=http://127.0.0.1:10000

# F-002 H3: el fixture de acceso se habilita sólo en el backend local no productivo.

# Checkout stays on local fixtures unless explicitly switched for local testing.
NEXT_PUBLIC_CHECKOUT_MODE=local-fixtures
MOCK_AUTH_URL=http://127.0.0.1:4010
CHECKOUT_MODE=local-fixtures

# For a local Cart -> Checkout smoke only, set both mode variables to backend-mock.
# Checkout reads the authoritative cart/version through /api/cart/current; no version override is used.
