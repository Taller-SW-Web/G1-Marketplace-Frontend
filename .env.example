# ==============================================================================
# CONFIGURACIÓN LOCAL PARA DESARROLLO (Frontend Next.js)
# ==============================================================================

# 1. URL del Backend / BFF de Marketplace en entorno local
# El backend NestJS corre por defecto en el puerto 10000.
MARKETPLACE_API_URL=http://127.0.0.1:10000
# Presupuesto server-only Next -> BFF: 1000..30000 ms; defecto/valor inválido = 8000.
# En demo G6 lenta puede usarse 25000 con PRODUCTOS_TIMEOUT_MS=20000 en Backend.
# Esto permite esperar al proveedor; no corrige su latencia ni respuestas 503.
CATALOG_BFF_TIMEOUT_MS=8000

# H4 cuenta G7: habilitar sólo con el BFF y su clave de sesión configurados.
G1_AUTH_ENABLED=false
G1_WEB_ORIGIN=http://127.0.0.1:3000
# Documentos publicados y aprobados antes de habilitar el registro (HTTPS).
G1_TERMS_URL=
G1_PRIVACY_URL=
# En producción, ambos orígenes deben ser HTTPS. No usar NEXT_PUBLIC_* para secretos.
# Deshabilitar H3_FRONTEND_SANDBOX_ENABLED al activar G7.

# 2. Origen exacto del Frontend en el navegador (Sin barra final '/')
# Utilizado por la protección estricta anti-CSRF en mutaciones de sesión.
H3_FRONTEND_ORIGIN=http://127.0.0.1:3000

# 3. Modo de Checkout y Pago Simulado
# Opciones disponibles:
# - 'local-fixtures': Utiliza direcciones y pasarela de simulación local (Recomendado para desarrollo).
# - 'backend-mock': Requiere levantar en paralelo el emisor de identidades local (npm run mock:auth en backend).
CHECKOUT_MODE=local-fixtures
NEXT_PUBLIC_CHECKOUT_MODE=local-fixtures

# 4. Servidor Mock de Autenticación local (Solo si se usa CHECKOUT_MODE=backend-mock)
MOCK_AUTH_URL=http://127.0.0.1:4010

# 5. Lista de Deseos / Favoritos (H3 Wishlist)
# Habilita la lectura y persistencia de favoritos en entorno local.
H3_WISHLIST_READ_ENABLED=true

# 6. Modo Sandbox de Autenticación H3
# Deshabilitado por defecto para navegación estándar.
H3_FRONTEND_SANDBOX_ENABLED=false
H3_SANDBOX_TOKEN_A=
H3_SANDBOX_TOKEN_B=

# ==============================================================================
# INSTRUCCIONES PARA EJECUTAR EN LOCAL:
# 1. Copia este archivo como .env.local:
#    cp .env.example .env.local
# 2. Asegúrate de que el Backend esté corriendo en http://127.0.0.1:10000
# 3. Inicia el servidor de desarrollo del Frontend:
#    npm run dev
# 4. Abre en tu navegador: http://127.0.0.1:3000
# ==============================================================================
